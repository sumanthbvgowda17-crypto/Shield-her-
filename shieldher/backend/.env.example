# ShieldHer Backend - Safe Environment Example
# Private server-side secrets. Never commit actual values to Git.

PORT=5001
NODE_ENV=production
GROQ_API_KEY=your_groq_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
GUARDIAN_VERIFIED_PHONE=+91XXXXXXXXXX
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKUP_TWILIO_ACCOUNT_SID=your_backup_twilio_sid_here
BACKUP_TWILIO_AUTH_TOKEN=your_backup_twilio_token_here
BACKUP_TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
